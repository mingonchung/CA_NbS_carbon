#!/bin/bash
#SBATCH --job-name=ca_8_match
#SBATCH --partition=acpu #amem #acpu
#SBATCH --qos=cpu-long #mem-long #cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=24 #16
#SBATCH --mem=128G #256G
#SBATCH --time=4-00:00:00
#SBATCH --array=7-12 #1-6: baseline, 7-12: gpp+agb+ch, 13-18: gpp+agb
#SBATCH --output=/home/mich9173/log/8_match_%A_%a.qlog


# AUGUST 5 MAINTENANCE
#
# Reservation pm-8.5-amilan holds all 420 acpu nodes from 2026-08-05T06:30 to
# 2026-08-06T06:30, and pm-8.5-amem holds all 24 amem nodes over the identical
# window. Slurm will not start a job that cannot finish before a reservation
# begins, so anything asking for more than the hours remaining until 06:30 on
# August 5 sits at ReqNodeNotAvail until the window clears. Switching to amem
# does not help, since amem is reserved too.
#
# Two options. Leave the job queued and it starts when the window ends, or make
# the wait explicit so the estimated start time is visible.
#
#   sbatch --begin=2026-08-06T07:00 ...
#
# To use the hours before the window, run the small pairings under the normal
# QoS with a wall clock short enough to finish first. ONP_UNP and UP_UNP take
# about 1 and 4 hours for the nine non-bart configs.
#
#   export CA_CONFIGS="nn_exact_1to1,glm_nocal,glm_cal025,elastic_nocal,elastic_cal025,mahal_nocal,mahal_pscal,rmahal_nocal,rmahal_cal025"
#   sbatch --qos=normal --time=12:00:00 --export=ALL --array=1,2 8_match_pairings.sub
#
# A pilot writes to the same two shared tables as the full run, and the run
# guard only protects the matched parquet files, not the appends. Clear the
# work directory before the full submission or the specs and balance tables
# carry every pilot row twice.
#
# PARTITION AND QOS NAMES
#
# CURC renames amilan to acpu and the amilan long QoS to cpu-long on
# August 5, 2026. Both new names are accepted now, and a 7 day job submitted
# today runs straight through the rename, so the new names are used here rather
# than the old ones. If sbatch rejects either name, check what this allocation
# actually has before editing.
#
#   sinfo -o "%P"
#   sacctmgr show assoc user=$USER format=partition,qos
#
# The probe line below uses the normal QoS. The rename notice named only the
# long QoS, so normal may or may not have become cpu-normal. The sacctmgr line
# above settles it.
#
# WHY THE LONG QOS
#
# The 7 day wall clock exists only under long, and long is valid on acpu alone.
# The normal QoS caps at 1 day, which the bart configs exceed on four of the six
# pairings. long trades priority for wall time and allows 200 jobs and 20 nodes
# per user. The three submissions across the two files total 54 array tasks,
# well inside the job limit, and they queue against the node limit rather than
# fail.
#
# MEMORY
#
# acpu provides 3.8 GB of RAM per core, so 32 cores is 121 GB and this asks for
# 128 GB of it. The job is effectively single threaded, since MatchIt and glmnet
# do not parallelise the fit. The cores are here for the RAM and the arrow reads.
#
# Measured, not guessed. The largest matching input in the whole set is TP_UP
# augmented at level 1986_1990, 14.4 million rows, which peaked at 14.6 GB under
# the nine non-bart configs. The headroom covers the extra columns that the
# balance table now carries and the larger inputs the augmented arms build.
#
# The two bart configs go to 8_match_pairings_bart.sub, which sits on amem.
#
# THE ARRAY
#
# Task index is pairing crossed with arm, from ca_match_tasks().
#
#    1-6   UP_UNP ONP_UNP FP_UP FNP_UNP TP_UP TNP_UNP   baseline
#    7-12  same order                                   augmented
#   13-18  same order                                   augmented_noch
#
#   Rscript $HOME/8_match_pairings.R tasks
#
# THIS FILE RUNS THE NINE NON-BART CONFIGS
#
# Every config runs and nothing is dropped. bart is 80 times slower than glm at
# the same input and the two bart configs are 80 percent of the sweep, so all
# eleven in one task would need 12 days on TP_UP. Splitting is a scheduling
# decision. Each config writes its own matched file and appends to the two
# shared tables, so the split needs no merge and changes no result.
#
#   export CA_CONFIGS="nn_exact_1to1,glm_nocal,glm_cal025,elastic_nocal,elastic_cal025,mahal_nocal,mahal_pscal,rmahal_nocal,rmahal_cal025"
#   sbatch --export=ALL --array=1-18 8_match_pairings.sub
#
# Then the two bart configs, on amem.
#
#   sbatch --export=ALL,CA_CONFIGS=bart_nocal  --array=1-18 8_match_pairings_bart.sub
#   sbatch --export=ALL,CA_CONFIGS=bart_cal025 --array=1-18 8_match_pairings_bart.sub
#
# EXPORT THE VARIABLE FIRST. Do not put the list inside --export. sbatch splits
# its own --export argument on commas, so
#
#   sbatch --export=ALL,CA_CONFIGS=a,b,c
#
# sets CA_CONFIGS to a and then tries to export variables named b and c. The
# list arrives truncated to its first element with no error, which turns a nine
# config sweep into a one config run. Colons survive if a one-liner is wanted.
#
#   sbatch --export=ALL,CA_CONFIGS=bart_nocal:bart_cal025 --array=1-18 8_match_pairings.sub
#
# Unset it before the next submission, since --export=ALL carries the whole
# environment and a stale CA_CONFIGS will silently narrow the run.
#
#   unset CA_CONFIGS
#
# Estimated from the probe, hours per task, baseline arm. The augmented arms
# add about 1 hour for the pre-treatment reads.
#
#   pairing    nine non-bart    one bart
#   ONP_UNP          1              3
#   UP_UNP           4              9
#   FNP_UNP         12             25
#   FP_UP           33             73
#   TNP_UNP         41             89
#   TP_UP           52            114
#
# If a bart task on TP_UP or TNP_UNP still hits the wall, split it by level.
# Levels are independent and the matched filename carries the range.
#
#   export CA_CONFIGS="bart_nocal"; export CA_LEVELS="1-18"
#   sbatch --export=ALL --array=5 8_match_pairings.sub
#   export CA_LEVELS="19-36"
#   sbatch --export=ALL --array=5 8_match_pairings.sub
#
# PROBE, on the normal QoS since it takes minutes rather than days. Not on
# atesting, which caps at 1 hour, 5 jobs, and 2 nodes, so an array of six will
# not fit.
#
#   sbatch --qos=normal --time=04:00:00 --export=ALL,CA_MODE=probe --array=1-6 8_match_pairings.sub
#
# Archive once every submission has finished, from a login node.
#
#   Rscript $HOME/8_match_pairings.R archive
#
# Then aggregate the per-level rows into the per-pairing table that Table S3 and
# Figure S6 need. Stage 8 writes one row per cohort level, not one per pairing.
#
#   Rscript $HOME/8b_aggregate_match.R

module purge
module load anaconda
conda activate MC0617

command -v Rscript >/dev/null 2>&1 || {
  echo "Rscript not on PATH after activating MC0617"
  exit 1
}

export CA_ARCHIVE=/projects/mich9173/CA_carbon
export CA_SCRATCH=/scratch/alpine/mich9173/CA_carbon

Rscript "$HOME/8_match_pairings.R" ${CA_MODE:-run}
