#!/bin/bash
#SBATCH --job-name=ca_7_sample
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128G
#SBATCH --time=06:00:00
#SBATCH --array=1-3
#SBATCH --output=/home/mich9173/log/7_sample_%A_%a.qlog


# Task 1 Decid, 2 Everg, 3 Mixed.
#
# Probe mode writes meta/sample_floor_<class>.csv, the retention and per-cell
# diagnostic. It has already run and run mode does not depend on it. Rerun it
# only if the stage 6 groups change.
#
#   sbatch --export=ALL,CA_MODE=probe 7_sample_grid.sub
#
# The run itself.
#
#   sbatch 7_sample_grid.sub
#
# Archive once all three classes have written, from a login node.
#
#   Rscript $HOME/7_sample_grid.R archive
#
# Memory. Evergreen holds roughly 38 million treated-role pixels across the
# fourteen groups and each group is spaced on its own, so peak is set by UP at
# about 24 million rows plus a representative table of about one million.
# If task 2 is killed, resubmit that task alone at a higher --mem rather than
# raising it for all three.

# Environment. The pinned module string is gone from Alpine, so the module name
# comes from CA_CONDA_MODULE if the site renames it again, and a direct source
# of conda.sh is the fallback. The block fails loudly rather than running R from
# the system path in the wrong environment.

module purge
module load "${CA_CONDA_MODULE:-anaconda}" 2>/dev/null || \
  echo "Module load skipped, falling back to a direct conda.sh source"

if ! command -v conda >/dev/null 2>&1; then
  for CONDA_HOME in "$HOME/miniconda3" "$HOME/anaconda3" "$HOME/miniforge3" \
                    "$HOME/mambaforge" /curc/sw/anaconda3/latest; do
    if [ -f "$CONDA_HOME/etc/profile.d/conda.sh" ]; then
      source "$CONDA_HOME/etc/profile.d/conda.sh"
      break
    fi
  done
fi

command -v conda >/dev/null 2>&1 || {
  echo "conda not found. Run 'module -t avail' and 'conda info --base' on a"
  echo "login node and set CA_CONDA_MODULE or add the base path above."
  exit 1
}

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate MC0617

command -v Rscript >/dev/null 2>&1 || {
  echo "Rscript not on PATH after activating MC0617"
  exit 1
}

export CA_ARCHIVE=/projects/mich9173/CA_carbon
export CA_SCRATCH=/scratch/alpine/mich9173/CA_carbon

Rscript "$HOME/7_sample_grid.R" ${CA_MODE:-run}
