#!/bin/bash
#SBATCH --job-name=ca_6_verify
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128G
#SBATCH --time=06:00:00
#SBATCH --array=1-9
#SBATCH --output=/home/mich9173/log/6_verify_%A_%a.qlog


# All nine sections from one submission:
#
#   sbatch 6_verify_groups.sub
#
# Deciduous or Mixed instead of Evergreen:
#
#   sbatch --export=ALL,CA_CLASS=Decid 6_verify_groups.sub
#
# An array rather than a loop inside one process, for the same reason as stage
# 5. Each task gets a fresh R process, which is the only thing that reliably
# returns Arrow's off-heap pool to the OS, and the eight run in parallel.
#
# Section 8, feasibility, is the one to read first. It reports how many matched
# pairs each pairing can actually yield, which is the sum over exact cells of
# the smaller side rather than the size of either side.
#
# Section 9, sample, requires stage 7 output and fails without it. Run the
# first eight before stage 7 and all nine after, or run section 9 alone:
#
#   sbatch --array=9 6_verify_groups.sub

module purge
module load anaconda/2023.09

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate MC0617

export CA_ARCHIVE=/projects/mich9173/CA_carbon
export CA_SCRATCH=/scratch/alpine/mich9173/CA_carbon

SECTIONS=(integrity ledger stage5 groups control spatial taxonomy feasibility sample)
SECTION=${SECTIONS[$((SLURM_ARRAY_TASK_ID - 1))]}
CLASS=${CA_CLASS:-Everg}

Rscript "$HOME/6_verify_groups.R" "$SECTION" "$CLASS"
