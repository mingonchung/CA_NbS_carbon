#!/bin/bash
#SBATCH --job-name=ca_6a_group_codes
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=128G
#SBATCH --time=12:00:00
#SBATCH --array=1-3
#SBATCH --output=/home/mich9173/log/6a_group_codes_%A_%a.qlog


# Task 1 Decid, 2 Everg, 3 Mixed.
#
# Run the probe first, once, on its own. It writes
# meta/nondisturbing_decision.csv and the array errors without it.
#
#   sbatch --array=1 --job-name=ca_6a_probe \
#          --wrap="..."   or edit MODE below and submit once.
#
# Evergreen sorts an event table of roughly eighty million rows. If task 2 is
# killed for memory, resubmit that task alone at a higher --mem rather than
# raising it for all three.

module purge
module load anaconda/2023.09

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate MC0617

export CA_ARCHIVE=/projects/mich9173/CA_carbon
export CA_SCRATCH=/scratch/alpine/mich9173/CA_carbon

Rscript "$HOME/6a_group_codes.R"
