#!/bin/bash
#SBATCH --job-name=ca_4b_cov
#SBATCH --partition=acpu
#SBATCH --qos=cpu-normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=04:00:00
#SBATCH --array=1-3
#SBATCH --output=/home/mich9173/log/4b_cov_%A_%a.qlog


# Task 1 Decid, 2 Everg, 3 Mixed. Evergreen is 95.6 million rows and sizes the
# memory request. The other two finish in minutes.

module purge
module load anaconda/2023.09

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate MC0617

export CA_ARCHIVE=/projects/mich9173/CA_carbon
export CA_SCRATCH=/scratch/alpine/mich9173/CA_carbon

Rscript "$HOME/4b_clean_covariates.R"
